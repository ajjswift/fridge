# Required when a database has no users yet. Copy this file to .env.local and
# replace both values before starting the app.
RECIME_SEED_USERNAME=your-username
RECIME_SEED_PASSWORD=choose-a-long-unique-password

# Set this to use PostgreSQL. Leave it unset to use ./data/recime.db instead.
# DATABASE_URL=postgres://user:password@localhost:5432/fridge

# Optional: enables instant shopping-list updates across multiple app instances.
# Leave unset to use the built-in single-instance SSE fan-out and polling fallback.
# REDIS_URL=redis://default:password@localhost:6379
